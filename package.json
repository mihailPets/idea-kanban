  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@types/node": "18.19.130",
    "@types/react": "18.3.28",
    "@types/react-dom": "18.3.7",
    "css-loader": "7.1.2",
    "eslint": "9.39.1",
    "html-webpack-plugin": "5.6.5",
    "style-loader": "4.0.0",
    "ts-loader": "9.6.2",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.50.0",
    "webpack": "5.112.2",
    "webpack-cli": "5.1.4",
    "webpack-dev-server": "5.2.7"
